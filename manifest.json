{
  "manifest_version": 3,

  "name": "Theme Invert",
  "version": "1.0.0",
  "description": "Invert page colors per domain.",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_icon": "icons/on.svg",
    "default_title": "Theme invert: ON"
  },

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
